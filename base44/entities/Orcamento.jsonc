{
  "name": "Orcamento",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "contato": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "uf": {
      "type": "string",
      "description": "Unidade federativa para c\u00e1lculo de ICMS"
    },
    "tipo_produto": {
      "type": "string",
      "description": "Ex.: P.Pallets, Drive In, Estantes, Cantilever..."
    },
    "data": {
      "type": "string",
      "format": "date"
    },
    "validade_dias": {
      "type": "number",
      "default": 15
    },
    "componentes": {
      "type": "array",
      "description": "Pe\u00e7as estruturais do or\u00e7amento",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "corte": {
            "type": "number"
          },
          "comprimento": {
            "type": "number"
          },
          "custo_aco_id": {
            "type": "string"
          },
          "peso_especifico": {
            "type": "number"
          },
          "preco_kg": {
            "type": "number"
          },
          "peso_unit": {
            "type": "number"
          },
          "peso_total": {
            "type": "number"
          },
          "custo": {
            "type": "number"
          }
        }
      }
    },
    "componentes_comerciais": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descricao": {
            "type": "string"
          },
          "unidade": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "custo_unitario": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "custo_total_aco": {
      "type": "number"
    },
    "peso_total_aco": {
      "type": "number"
    },
    "custo_acessorios": {
      "type": "number"
    },
    "montagem": {
      "type": "number",
      "description": "Custo de montagem (R$)"
    },
    "frete": {
      "type": "number",
      "description": "Custo de frete (R$)"
    },
    "comissao_percentual": {
      "type": "number",
      "description": "Comiss\u00e3o do vendedor (%)"
    },
    "margem_minima": {
      "type": "number",
      "default": 15
    },
    "margem_adequada": {
      "type": "number",
      "default": 30
    },
    "valor_venda": {
      "type": "number",
      "description": "Pre\u00e7o de venda proposto (R$)"
    },
    "custo_total": {
      "type": "number"
    },
    "carga_tributaria": {
      "type": "number"
    },
    "impostos_valor": {
      "type": "number"
    },
    "comissao_valor": {
      "type": "number"
    },
    "margem_real": {
      "type": "number"
    },
    "lucro_real": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "enviado",
        "aprovado",
        "recusado"
      ],
      "default": "rascunho"
    }
  },
  "required": [
    "titulo",
    "tipo_produto"
  ]
}