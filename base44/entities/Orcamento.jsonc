{
  "name": "Orcamento",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "contato": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "uf": {
      "type": "string",
      "description": "Unidade federativa para c\u00e1lculo de ICMS"
    },
    "numero_projeto": {
      "type": "string"
    },
    "numero_folha": {
      "type": "string"
    },
    "data": {
      "type": "string",
      "format": "date"
    },
    "validade_dias": {
      "type": "number",
      "default": 15
    },
    "produtos": {
      "type": "array",
      "description": "Lista de produtos do or\u00e7amento (ex.: porta-palete + estante)",
      "items": {
        "type": "object",
        "properties": {
          "tipo_produto": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "componentes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nome": {
                  "type": "string"
                },
                "quantidade": {
                  "type": "number"
                },
                "corte": {
                  "type": "number"
                },
                "comprimento": {
                  "type": "number"
                },
                "custo_aco_id": {
                  "type": "string"
                },
                "peso_especifico": {
                  "type": "number"
                },
                "peso_unit": {
                  "type": "number"
                },
                "peso_total": {
                  "type": "number"
                }
              }
            }
          },
          "componentes_comerciais": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "descricao": {
                  "type": "string"
                },
                "unidade": {
                  "type": "string"
                },
                "quantidade": {
                  "type": "number"
                },
                "custo_unitario": {
                  "type": "number"
                },
                "total": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "preco_aco_kg": {
      "type": "number",
      "description": "Pre\u00e7o de mercado do a\u00e7o (R$/kg)"
    },
    "peso_total_aco": {
      "type": "number"
    },
    "custo_total_aco": {
      "type": "number"
    },
    "custo_acessorios": {
      "type": "number"
    },
    "montagem": {
      "type": "number"
    },
    "cobrar_montagem": {
      "type": "boolean"
    },
    "frete": {
      "type": "number"
    },
    "cobrar_frete": {
      "type": "boolean"
    },
    "comissao_percentual": {
      "type": "number"
    },
    "margem_minima": {
      "type": "number",
      "default": 15
    },
    "margem_adequada": {
      "type": "number",
      "default": 30
    },
    "valor_venda": {
      "type": "number"
    },
    "custo_empresa": {
      "type": "number"
    },
    "total_cliente": {
      "type": "number"
    },
    "carga_tributaria": {
      "type": "number"
    },
    "impostos_valor": {
      "type": "number"
    },
    "comissao_valor": {
      "type": "number"
    },
    "margem_real": {
      "type": "number"
    },
    "lucro_real": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "enviado",
        "aprovado",
        "recusado"
      ],
      "default": "rascunho"
    }
  },
  "required": [
    "titulo"
  ]
}